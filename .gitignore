*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data (common for biomedical projects)
data/raw/
data/processed/
*.csv
*.tsv
*.parquet
*.h5
*.json
data/**/*.json
*.png
*.pdf

# Allow our designated example/groundtruth datasets
!data/examples/metabolites_synthetic.tsv
!data/examples/metabolites_synthetic_partial_provided.tsv
!data/examples/olink_protein_metadata.tsv
!data/groundtruth/diseases_handcrafted.tsv

# Pinned benchmark artifacts committed as part of study packages (not scratch data).
!studies/northstar_e2e/data/suhre2010_canonical.csv
!studies/northstar_e2e/data/kegg_compound_pathway.tsv

# Analysis artifacts that back numbers asserted in source comments. These MUST stay tracked --
# a blanket *.json ignore is exactly how a number ends up cited with no artifact behind it.
!studies/analysis/results/*.json

# Committed test fixtures. Same failure mode, one step earlier: the certificate audit's
# offline-reproducibility gate reads a small anonymized mapped-row fixture, and the pinned baseline
# it replaces lives outside the repo, so this file is the only input that gate can ever have. Under
# the blanket *.tsv rule it stays green locally and vanishes on a fresh clone.
!tests/fixtures/**/*.tsv
!tests/fixtures/**/*.json

# Other app-specific items
cache/
.env

# Serena AI tool
.serena/

# Memtrace code-graph daemon (per-checkout runtime state: pid, port, local MemDB)
.memdb/
.memtrace/
