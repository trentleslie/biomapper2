# Kestrel knowledge graph API.
# The public endpoint is the default and needs no key (it ignores X-API-Key).
KESTREL_API_URL=https://kestrel.krakenkg.com/api
# Only required by the internal endpoint (KESTREL_API_URL=https://kestrel.nathanpricelab.com/api),
# which serves a different KRAKEN build. Check with: curl $KESTREL_API_URL/metagraph
KESTREL_API_KEY=your_kestrel_api_key_here

# Optional: protect biomapper2 API endpoints with key(s)
# If unset, the API runs in open-access mode (fine for local use)
# BIOMAPPER_API_KEY=
# BIOMAPPER2_API_KEYS=key1,key2
